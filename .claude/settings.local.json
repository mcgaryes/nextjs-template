{
    "permissions": {
        "allow": ["Bash(find:*)", "Bash(npx shadcn@latest add:*)", "Bash(ls:*)", "Bash(pnpm lint:*)", "Bash(tree:*)"]
    },
    "enabledMcpjsonServers": ["shadcn"],
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "scripts/claude-hooks/prettier-after-change.sh"
                    }
                ]
            }
        ]
    },
    "enableAllProjectMcpServers": true
}
